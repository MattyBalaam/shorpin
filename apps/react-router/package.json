{
  "name": "@shorpin/react-router",
  "version": "0.2.0",
  "private": true,
  "files": [
    "build",
    "instrument.server.mjs"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names mock,app \"pnpm --filter @shorpin/mocks start\" \"react-router dev --mode mock\"",
    "dev:mock": "react-router dev --mode mock",
    "dev:supabase": "react-router dev",
    "dev:e2e": "react-router dev --mode test",
    "build": "react-router build",
    "build:preview": "react-router build --mode preview",
    "build:analyse": "react-router build --mode analyse",
    "build:test": "react-router build --mode test",
    "build:mock": "react-router build --mode mock",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "serve": "react-router-serve ./build/server/index.js",
    "serve:https": "concurrently --kill-others --names serve,tls \"PORT=3000 react-router-serve ./build/server/index.js\" \"local-ssl-proxy --source 3443 --target 3000 --cert ../../.certs/lan.pem --key ../../.certs/lan-key.pem\"",
    "preview:https": "pnpm build:test && pnpm serve:https",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "generate-pwa-assets": "pwa-assets-generator && mv public/icons/favicon.ico public/favicon.ico",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@conform-to/react": "1.21.2",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "@sentry/profiling-node": "^11.10.0",
    "@sentry/react-router": "^11.10.0",
    "@supabase/realtime-js": "^2.118.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "catalog:",
    "isbot": "5.2.2",
    "linkify-it": "^6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "remix-toast": "4.0.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@msw/data": "catalog:",
    "@react-router/dev": "8.5.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@shorpin/database": "workspace:*",
    "@shorpin/mocks": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "10.0.6",
    "local-ssl-proxy": "^2.0.5",
    "msw": "catalog:",
    "react-router-devtools": "6.2.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vite-plugin-devtools-json": "1.1.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
