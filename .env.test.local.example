# Test Supabase project — used by `pnpm test:e2e` and `pnpm dev:e2e`.
# Copy this file to .env.test.local and fill in the *test* project's
# credentials (Project Settings > API in the Supabase dashboard).
#
# Never point this at the production project — SUPABASE_SERVICE_ROLE_KEY
# bypasses RLS and globalSetup/teardown create and delete real auth users.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
