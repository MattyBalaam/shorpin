# Used by `pnpm dev:supabase`, `pnpm build`, and `pnpm start` (no --mode set).
# Copy this file to .env (gitignored) and fill in your real project's values —
# this is what runs against an actual Supabase backend instead of mocks, and
# what production deploys use.

# Sentry Configuration
# Get these from https://sentry.io/settings/
VITE_SENTRY_DSN=
SENTRY_ORG=

# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://neelrjmyvtuqxlmxxjub.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_fLyT635CPkSTQGE_ABTMkw_XlhnMDni
