# Used by `pnpm build:preview` (Vite --mode preview).
# Placeholder Supabase values for preview/deploy-preview builds where the
# mock server isn't running. Safe to commit: not real credentials.

VITE_SUPABASE_URL=https://mock.preview.local
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=preview-anon-key

# Optional: the e2e test project, offered on the login page beside the mock
# (app/lib/supabase-backend.ts). Coolify sets these as build variables; leave
# them empty here. Never use the production project.
VITE_TEST_SUPABASE_URL=
VITE_TEST_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
