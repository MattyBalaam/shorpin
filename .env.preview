# Copied to dist/runtime.env by `pnpm build:preview` (Coolify PR previews).
# The server applies it at startup for anything not already set, and in
# preview mode intercepts every Supabase call with the in-memory mock
# (server/preview.ts), so these placeholders are never contacted. Safe to
# commit: not real credentials.

APP_MODE=preview
VITE_SUPABASE_URL=https://mock.preview.local
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=preview-anon-key

# Optional, set on the deployment rather than here: VITE_TEST_SUPABASE_URL and
# VITE_TEST_SUPABASE_PUBLISHABLE_DEFAULT_KEY offer the e2e test project at
# login (server/backend.ts); TEST_SUPABASE_SERVICE_ROLE_KEY (runtime only)
# adds the one-click preview user (server/preview-user.ts).
