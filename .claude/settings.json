{
  "permissions": {
    "allow": [
      "Bash(zsh -c 'which node; which pnpm; node -v; pnpm -v')",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Read(//private/tmp/claude-502/**)",
      "Bash(pnpm install *)",
      "Bash(lsof -i :5174 -sTCP:LISTEN)",
      "Bash(lsof -i :5173 -sTCP:LISTEN)",
      "Bash(lsof -iTCP -sTCP:LISTEN -P)",
      "Bash(ps -u matthewbalaam -o pid,command)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-checks.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-checks.sh"
          }
        ]
      }
    ]
  }
}
