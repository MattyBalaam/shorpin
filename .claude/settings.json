{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(pnpm install *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh pr *)",
      "Bash(pnpm add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-checks.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-checks.sh"
          }
        ]
      }
    ]
  }
}
