# Used by `pnpm dev` and `pnpm test:integration` (Vite --mode mock).
# Points at the local mock server (mocks/server.ts) instead of real Supabase —
# no setup needed, this is the default day-to-day dev loop. Safe to commit:
# these aren't real credentials, just enough to satisfy the client's checks.

VITE_SUPABASE_URL=http://localhost:9001
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=test-anon-key
