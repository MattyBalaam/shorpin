{
  "name": "shorpin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @shorpin/react-router dev",
    "dev:supabase": "pnpm --filter @shorpin/react-router dev:supabase",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-git-hooks.mjs')) await import('./scripts/install-git-hooks.mjs');\"",
    "build": "pnpm --filter @shorpin/react-router build",
    "typecheck": "tsc && pnpm --recursive --parallel typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --config oxlint.json",
    "lint:fix": "oxlint --fix --config oxlint.json",
    "verify": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm fmt:check",
    "db:push": "supabase db push",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "knip": "knip",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --recursive --if-present test:unit",
    "test:e2e": "pnpm --filter @shorpin/specs test:e2e",
    "test:integration": "pnpm --filter @shorpin/specs test:integration",
    "test:visual": "pnpm --filter @shorpin/specs test:integration --project iphone-pro-max --project laptop",
    "test:visual:update": "pnpm --filter @shorpin/specs test:integration --project iphone-pro-max --project laptop --update-snapshots",
    "bench": "node --env-file-if-exists=.env.staging.local --env-file-if-exists=.env.prod.local scripts/bench/compare.ts",
    "keepalive:supabase": "node scripts/supabase-keepalive.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.43.0",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "supabase": "2.122.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "vite-plugin-devtools-json>vite": "8.3.5",
      "playwright-core": "1.64.1",
      "uuid": "^14.0.2"
    }
  }
}
