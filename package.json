{
  "name": "shorpin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names mock,app \"node --experimental-strip-types mocks/server.ts\" \"vite dev --mode mock\"",
    "dev:supabase": "vite dev",
    "dev:e2e": "vite dev --mode e2e",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-git-hooks.mjs')) await import('./scripts/install-git-hooks.mjs');\"",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "build:analyse": "vite build --mode analyse",
    "build:e2e": "vite build --mode e2e",
    "start": "NODE_ENV=production node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "serve:https": "concurrently --kill-others --names serve,tls \"PORT=3000 node .output/server/index.mjs\" \"local-ssl-proxy --source 3443 --target 3000 --cert .certs/lan.pem --key .certs/lan-key.pem\"",
    "preview:https": "pnpm build:e2e && pnpm serve:https",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --config oxlint.json",
    "lint:fix": "oxlint --fix --config oxlint.json",
    "verify": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm fmt:check",
    "db:push": "supabase db push",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "knip": "knip",
    "test": "vitest",
    "test:e2e": "playwright test --config playwright.supabase.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "bench": "node --env-file-if-exists=.env.staging.local --env-file-if-exists=.env.prod.local scripts/bench/compare.ts",
    "test:visual": "node scripts/test-integration.mjs --project iphone-pro-max --project laptop",
    "test:visual:update": "node scripts/test-integration.mjs --project iphone-pro-max --project laptop --update-snapshots",
    "keepalive:supabase": "node scripts/supabase-keepalive.mjs",
    "generate-pwa-assets": "pwa-assets-generator && mv public/icons/favicon.ico public/favicon.ico"
  },
  "dependencies": {
    "@formisch/solid": "1.3.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.16",
    "@sentry/browser": "^11.11.0",
    "@sentry/node": "^11.11.0",
    "@sentry/profiling-node": "^11.11.0",
    "@solidjs/web": "2.0.0-rc.21",
    "@supabase/realtime-js": "^2.119.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "@tanstack/solid-start": "2.0.0-rc.10",
    "linkify-it": "^6.1.0",
    "solid-js": "2.0.0-rc.21",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@msw/data": "1.1.8",
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "11.11.0",
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "concurrently": "10.0.6",
    "knip": "6.44.1",
    "local-ssl-proxy": "^2.0.5",
    "msw": "3.0.3",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.76.0",
    "oxlint": "^1.91.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "ws": "8.22.1"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "vite-plugin-devtools-json>vite": "$vite",
      "playwright-core": "$@playwright/test",
      "uuid": "^14.0.2"
    }
  }
}
