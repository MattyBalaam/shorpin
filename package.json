{
  "name": "shorpin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names mock,client,sw,server \"node mocks/server.ts\" \"vite build --watch --mode development\" \"vite build --watch --mode development --config vite.sw.config.ts\" \"node --watch-path=server --watch-path=lib --env-file=.env.mock server/index.ts\"",
    "dev:supabase": "concurrently --kill-others --names client,sw,server \"vite build --watch --mode development\" \"vite build --watch --mode development --config vite.sw.config.ts\" \"node --watch-path=server --watch-path=lib --env-file-if-exists=.env server/index.ts\"",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-git-hooks.mjs')) await import('./scripts/install-git-hooks.mjs');\"",
    "build": "vite build && vite build --config vite.sw.config.ts",
    "build:preview": "pnpm build && cp .env.preview dist/runtime.env",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc && tsc -p client/sw.tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --config oxlint.json",
    "lint:fix": "oxlint --fix --config oxlint.json",
    "verify": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm fmt:check",
    "db:push": "supabase db push",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "knip": "knip",
    "test": "vitest",
    "test:e2e": "playwright test --config playwright.supabase.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "bench": "node --env-file-if-exists=.env.staging.local --env-file-if-exists=.env.prod.local scripts/bench/compare.ts",
    "test:visual": "node scripts/test-integration.mjs --project iphone-pro-max --project laptop",
    "test:visual:update": "node scripts/test-integration.mjs --project iphone-pro-max --project laptop --update-snapshots",
    "keepalive:supabase": "node scripts/supabase-keepalive.mjs",
    "generate-pwa-assets": "pwa-assets-generator && mv public/icons/favicon.ico public/favicon.ico"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.17",
    "linkify-it": "^6.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@msw/data": "1.1.8",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "concurrently": "10.0.6",
    "knip": "6.43.0",
    "msw": "3.0.3",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "supabase": "2.122.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "playwright-core": "$@playwright/test",
      "uuid": "^14.0.2"
    }
  }
}
