{
  "name": "shorpin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names mock,app \"node --experimental-strip-types mocks/server.ts\" \"react-router dev --mode mock\"",
    "dev:supabase": "react-router dev",
    "dev:e2e": "react-router dev --mode test",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-git-hooks.mjs')) await import('./scripts/install-git-hooks.mjs');\"",
    "build": "react-router build",
    "build:preview": "react-router build --mode preview",
    "build:analyse": "react-router build --mode analyse",
    "build:test": "react-router build --mode test",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "serve:https": "concurrently --kill-others --names serve,tls \"PORT=3000 react-router-serve ./build/server/index.js\" \"local-ssl-proxy --source 3443 --target 3000 --cert .certs/lan.pem --key .certs/lan-key.pem\"",
    "preview:https": "pnpm build:test && pnpm serve:https",
    "typecheck": "react-router typegen && tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --config oxlint.json",
    "lint:fix": "oxlint --fix --config oxlint.json",
    "verify": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm fmt:check",
    "db:push": "supabase db push",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "knip": "knip",
    "test": "vitest",
    "test:e2e": "playwright test --config playwright.supabase.config.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@conform-to/react": "1.20.2",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "@sentry/profiling-node": "^10.62.0",
    "@sentry/react-router": "^10.62.0",
    "@supabase/realtime-js": "^2.108.2",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "isbot": "5.1.44",
    "linkify-it": "^5.0.1",
    "motion": "12.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "remix-toast": "4.0.0",
    "sonner": "2.0.7",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@msw/data": "1.1.7",
    "@playwright/test": "1.61.1",
    "@react-router/dev": "8.3.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/linkify-it": "^5.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "10.0.3",
    "knip": "6.23.0",
    "local-ssl-proxy": "^2.0.5",
    "msw": "2.14.6",
    "oxfmt": "0.56.0",
    "oxlint": "^1.71.0",
    "react-router-devtools": "6.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "2.108.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-devtools-json": "1.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "ws": "8.21.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "vite-plugin-devtools-json>vite": "$vite",
      "playwright-core": "$@playwright/test"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
