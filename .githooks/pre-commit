#!/bin/sh

# shorpin-managed-hook

set -eu

# Git hooks run in a bare subprocess that may not have node/pnpm on PATH
# (e.g. version managers like fnm/nvm that only activate in a login shell).
# Bootstrap fnm if it's present; no-op otherwise.
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env)"
fi

echo "[pre-commit] Running pnpm verify" >&2
pnpm verify
